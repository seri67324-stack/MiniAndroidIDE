<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Üst Başlık Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ide_terminal_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btnBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnToggleExplorer"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="☰"
            android:textColor="#38BDF8"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEditorSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSplitView"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="◫ Böl"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuildFromEditor"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▶ Derle (F5)"
            android:textSize="11sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- 2. Çoklu Dosya Sekme Çubuğu (Tab Bar) -->
    <HorizontalScrollView
        android:id="@+id/hsvTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B1120"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llTabs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </HorizontalScrollView>

    <!-- 3. Breadcrumb Çubuğu (proje > klasör > dosya) -->
    <HorizontalScrollView
        android:id="@+id/hsvBreadcrumb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#162032"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llBreadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </HorizontalScrollView>

    <!-- 4. Editör Araç Çubuğu -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ide_terminal_header"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <Button
                android:id="@+id/btnSave"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="💾 Kaydet"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnUndo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="↶ Geri Al"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnRedo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="↷ Yinele"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnFind"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🔍 Ara"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnProjectSearch"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🔎 Projede Ara"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnGoto"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="↕ Satıra Git"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnToggleBottomPanel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="▤ Panel"
                android:textAllCaps="false"
                android:textColor="#10B981"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnCommandPalette"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⌘ Komutlar"
                android:textAllCaps="false"
                android:textColor="#F59E0B"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnToggleKeyBar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⌨ PC Tuşları"
                android:textAllCaps="false"
                android:textColor="#A78BFA"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnKeySettings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⚙ Kısayollar"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnSnippet"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⚡ Şablon"
                android:textAllCaps="false"
                android:textColor="#10B981"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnZoomOut"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="A-"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnZoomIn"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="A+"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 4.5 Kalıcı Dosya İçi Ara / Değiştir Çubuğu -->
    <LinearLayout
        android:id="@+id/panelFindBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etFindQuery"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:hint="Dosyada ara..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFindCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="0/0"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFindCase"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="32dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Aa"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFindWord"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="\\b"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFindRegex"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=".*"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFindPrev"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="▲"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFindNext"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="▼"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFindClose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="28dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textColor="#EF4444"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llReplaceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etReplaceText"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:hint="Yerine yazılacak..."
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnReplaceOne"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Değiştir"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnReplaceAll"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Tümü"
                android:textAllCaps="false"
                android:textColor="#10B981"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Ana Çalışma Alanı Gövdesi: Sol Yan Panel (Explorer) + Çift Editör Bölmesi (Split View) -->
    <LinearLayout
        android:id="@+id/llWorkspaceBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Sol Yan Panel (Explorer Ağaç Görünümü) -->
        <LinearLayout
            android:id="@+id/panelExplorer"
            android:layout_width="235dp"
            android:layout_height="match_parent"
            android:background="#0F172A"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="#1E293B"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvExplorerHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="GEZGİN (EXPLORER)"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnExplorerNewFile"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="+Dosya"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="10.5sp" />

                <Button
                    android:id="@+id/btnExplorerNewDir"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="+Klasör"
                    android:textAllCaps="false"
                    android:textColor="#10B981"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/lvExplorerTree"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp" />
        </LinearLayout>

        <!-- Editör Bölmeleri (Birincil + İkincil Split View) -->
        <LinearLayout
            android:id="@+id/llEditorsContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Birincil Editör -->
            <com.miniide.app.editor.CodeEditText
                android:id="@+id/editor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:imeOptions="flagNoExtractUi"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- İkincil Editör Bölmesi (Split View - Yatay/Tablet veya Böl aktifken) -->
            <LinearLayout
                android:id="@+id/paneSecondaryEditor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:background="#1E293B"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/tvSecondaryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:fontFamily="monospace"
                        android:singleLine="true"
                        android:text="İkinci Bölme"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCloseSplit"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="28dp"
                        android:layout_height="24dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="✕"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33888888" />

                <com.miniide.app.editor.CodeEditText
                    android:id="@+id/editorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:imeOptions="flagNoExtractUi"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 5.5 VS Code Alt Paneli (Sürükleyerek Boyutlanabilir: Problemler, Çıktı, Terminal, Logcat) -->
    <LinearLayout
        android:id="@+id/panelBottom"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#0B1120"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Sürükleme Çubuğu (Drag Handle) -->
        <View
            android:id="@+id/viewBottomDragHandle"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="#334155" />

        <!-- Sekme Başlıkları -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="#1E293B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <Button
                android:id="@+id/btnTabProblems"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Problemler"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTabOutput"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Çıktı"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTabTerminal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Terminal"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTabLogcat"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Logcat"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCloseBottomPanel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="✕"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Alt Panel İçerik Alanı (Dinamik olarak sekme içeriğini barındırır) -->
        <FrameLayout
            android:id="@+id/containerBottomContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 6. VS Code Durum Çubuğu: Dal adı (Prompt 7 için), Satır:Sütun, Dil, Kodlama, Satır Sonu (LF/CRLF), Girinti (Boşluk:4) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ide_terminal_header"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvGitBranch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="12dp"
                android:text="⎇ main"
                android:textColor="#10B981"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCursorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="12dp"
                android:text="Satır 1, Sütun 1"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvIndentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="12dp"
                android:text="Boşluk:4"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvEncodingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="12dp"
                android:text="UTF-8"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvEolStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingEnd="12dp"
                android:text="LF"
                android:textColor="#F59E0B"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFileStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="JAVA"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 7. İkinci Tuş Çubuğu: Açılıp Kapanabilir PC Klavye Çubuğu -->
    <HorizontalScrollView
        android:id="@+id/hsvPcKeys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/llPcKeys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="3dp"
            android:paddingEnd="4dp"
            android:paddingBottom="3dp" />
    </HorizontalScrollView>

    <!-- 8. Birinci Sembol Çubuğu -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ide_terminal_bg"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llSymbols"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
